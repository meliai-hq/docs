{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Meliai",
  "theme": "mint",
  "colors": {
    "primary": "#7624F4",
    "light": "#7624F4",
    "dark": "#C8FF00"
  },
  "navbar": {
    "links": [
      {
        "label": "Usage",
        "href": "https://console.meliai.app/usage"
      },
      {
        "label": "Subscriptions",
        "href": "https://console.meliai.app/subscriptions"
      },
      {
        "label": "BYOO",
        "href": "https://console.meliai.app/hosted-accounts"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.meliai.app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Overview",
            "icon": "compass",
            "pages": [
              "quickstart",
              "introduction",
              "concepts/authentication",
              {
                "group": "Migration",
                "icon": "right-left",
                "pages": [
                  "get-started/from-openai",
                  "get-started/from-anthropic"
                ]
              }
            ]
          },
          {
            "group": "Models & Routing",
            "icon": "shuffle",
            "pages": [
              "concepts/models",
              "concepts/routing",
              "concepts/pricing"
            ]
          },
          {
            "group": "Features",
            "icon": "layer-group",
            "pages": [
              "guides/streaming",
              "guides/tool-calling",
              "guides/structured-outputs",
              "guides/batch-processing",
              "guides/vision",
              "guides/environmental-impact"
            ]
          },
          {
            "group": "Privacy",
            "icon": "shield-halved",
            "pages": [
              "concepts/privacy"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Inference",
            "pages": [
              "api-reference/chat-completions",
              "api-reference/messages",
              "api-reference/embeddings",
              "api-reference/rerank",
              "api-reference/images",
              "api-reference/audio"
            ]
          },
          {
            "group": "Batch & Files",
            "pages": [
              "api-reference/batches",
              "api-reference/files"
            ]
          },
          {
            "group": "Models",
            "pages": [
              "api-reference/models"
            ]
          }
        ],
        "icon": "code"
      },
      {
        "tab": "Integrations",
        "icon": "cubes",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/langchain",
              "integrations/vercel-ai-sdk",
              "integrations/n8n"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/meliai-hq"
    }
  },
  "description": "Meliai documentation, API reference, and integration guides.",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "weight": 400
  },
  "background": {
    "color": {
      "light": "#FCFCFE",
      "dark": "#03080A"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ],
    "display": "header"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://console.meliai.app"
  },
  "favicon": "/logo/mark.png"
}
